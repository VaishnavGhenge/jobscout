# Neon (or any Postgres) connection string. Get a free DB at https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: protects the cron/queue endpoints. Vercel Cron sends this automatically
# when set as an env var. Generate one: `openssl rand -hex 16`
CRON_SECRET=""

# Optional but recommended: a URL or email appended to the User-Agent we send to
# job boards. An anonymous crawler is the first thing an ops team blocks; a
# contactable one usually gets an email first.
JOBSCOUT_CONTACT=""
