{
  "name": "jobscout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "mcp:apply:build": "esbuild tools/apply-mcp/server.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=tools/apply-mcp/dist/server.mjs",
    "mcp:apply": "esbuild tools/apply-mcp/server.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=tools/apply-mcp/dist/server.mjs && node tools/apply-mcp/dist/server.mjs",
    "watch:build": "esbuild tools/watch/watch.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=tools/watch/dist/watch.mjs",
    "watch": "pnpm run watch:build && node --env-file=.env tools/watch/dist/watch.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.3",
    "zod": "^4.6.7"
  }
}
